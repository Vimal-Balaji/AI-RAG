# AWS S3 & Bedrock Configuration
S3_BUCKET_NAME=your-s3-bucket-name
AWS_DEFAULT_REGION=ap-south-1
AWS_REGION=ap-south-1

# Optional S3 subfolder/prefix (leave blank for root of bucket)
S3_PREFIX=

# AWS Credentials (if not using IAM roles or AWS CLI credentials ~/.aws/credentials)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Bedrock Model Configuration
BEDROCK_MODEL_ID=google.gemma-3-4b-it

# Chunk Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100
